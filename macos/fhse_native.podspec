#
# To learn more about a Podspec see http://guides.cocoapods.org/syntax/podspec.html.
#
Pod::Spec.new do |s|
  s.name             = 'fhse_native'
  s.version          = '0.1.0'
  s.summary          = 'FHSE (FIDO2 hmac-secret encryption), libcbor and libsodium.'
  s.description      = <<-DESC
vtnerd's FHSE, with libcbor and libsodium, built from vendored sources behind
the small C interface in src/wfhse.h.
                       DESC
  s.homepage         = 'https://github.com/MAGICGrants/fhse_native'
  s.license          = { :type => 'MIT', :file => '../LICENSE' }
  s.author           = { 'MAGIC Grants' => 'info@magicgrants.org' }

  # macOS build of the same C sources as ios/fhse_native.podspec; keep the two
  # in step. Classes/ holds one forwarding file per C source under ../src,
  # generated by tool/generate_ios_classes.sh; a podspec cannot name files
  # outside its directory.
  s.source           = { :path => '.' }
  s.source_files     = 'Classes/**/*.c'
  s.dependency 'FlutterMacOS'
  s.platform = :osx, '13.0'

  src = '${PODS_TARGET_SRCROOT}/../src'
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    # No header maps: CocoaPods' maps index every pod's headers ahead of the
    # search paths, and another pod's version.h shadowed libsodium's.
    'USE_HEADERMAP' => 'NO',
    'HEADER_SEARCH_PATHS' => [
      "\"#{src}\"",
      "\"#{src}/vendor/fhse/include\"",
      "\"#{src}/vendor/fhse/src\"",
      "\"#{src}/vendor/libcbor/src\"",
      "\"#{src}/vendor/libsodium/src/libsodium/include\"",
      "\"#{src}/vendor/libsodium/src/libsodium/include/sodium\"",
    ].join(' '),
    # The same definitions as src/CMakeLists.txt's Apple build; keep in step.
    # libsodium's optimised variants stay disabled, as there. Unlike iOS, macOS
    # has <sys/random.h> and getentropy.
    'GCC_PREPROCESSOR_DEFINITIONS' => [
      '$(inherited)',
      'FHSE_LIBSODIUM=1',
      'SODIUM_STATIC=1',
      'CONFIGURED=1',
      'HAVE_ATOMIC_OPS=1',
      'HAVE_C11_MEMORY_FENCES=1',
      'HAVE_GCC_MEMORY_FENCES=1',
      'HAVE_INTTYPES_H=1',
      'HAVE_STDINT_H=1',
      'NATIVE_LITTLE_ENDIAN=1',
      'TLS=_Thread_local',
      'HAVE_CLOCK_GETTIME=1',
      'HAVE_GETPID=1',
      'HAVE_MADVISE=1',
      'HAVE_MLOCK=1',
      'HAVE_MMAP=1',
      'HAVE_MPROTECT=1',
      'HAVE_NANOSLEEP=1',
      'HAVE_POSIX_MEMALIGN=1',
      'HAVE_PTHREAD=1',
      'HAVE_RAISE=1',
      'HAVE_SYSCONF=1',
      'HAVE_SYS_MMAN_H=1',
      'HAVE_SYS_PARAM_H=1',
      'HAVE_SYS_RANDOM_H=1',
      'HAVE_WEAK_SYMBOLS=1',
      'HAVE_TI_MODE=1',
      'HAVE_ARC4RANDOM=1',
      'HAVE_ARC4RANDOM_BUF=1',
      'HAVE_GETENTROPY=1',
      'HAVE_MEMSET_S=1',
      'HAVE_SAFE_ARC4RANDOM=1',
      'NONEXISTENT_DEV_RANDOM=1',
    ].join(' '),
    'GCC_C_LANGUAGE_STANDARD' => 'gnu11',
    # Only wfhse_* (marked default visibility in wfhse.h) leave the framework.
    # Passed as a flag: GCC_SYMBOLS_PRIVATE_EXTERN did not reach the compile
    # line in a Flutter app's Pods project.
    # Stack variables start zeroed, as src/CMakeLists.txt asks elsewhere; the
    # apps' Podfiles set it too, but this pod is not only theirs.
    'CLANG_ENABLE_STACK_ZERO_INIT' => 'YES',
    'OTHER_CFLAGS' => '$(inherited) -fvisibility=hidden -fno-strict-aliasing -fno-strict-overflow -fwrapv',
    'GCC_WARN_INHIBIT_ALL_WARNINGS' => 'YES',
  }
end
